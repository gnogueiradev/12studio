APP_NAME=12studio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

# Admin criado pelo DatabaseSeeder. Em producao o seeder FALHA se a password
# estiver vazia — nunca ha admin com password por omissao.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=admin@12studio.test
SEED_ADMIN_PASSWORD=

# Loja fechada ao publico: '/' mostra a landing "em breve". Poe true quando
# houver produtos para vender.
STORE_OPEN=false

# Cadeado das paginas de autenticacao. Vazio = desligado (dev/CI). Em producao
# gera um valor com `php artisan tinker --execute="echo Str::random(32);"` e
# visita uma vez /acesso/<segredo> para gravar o cookie nesse browser.
LOGIN_GATE_SECRET=
LOGIN_GATE_TTL_DAYS=30

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Em PRODUCAO a BD tem de viver no bind-mount storage/ (persiste entre
# deploys; backups diarios via db:backup caem em storage/backups):
# DB_DATABASE=/app/storage/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Em producao: redis (ver docker-compose). O driver database chega para dev.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
